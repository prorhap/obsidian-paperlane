{
  "name": "obsidian-paperlane",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/validate-manifest.mjs && node scripts/notices.mjs && tsc --noEmit && node esbuild.config.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs",
    "lint": "eslint src"
  },
  "license": "MIT",
  "dependencies": {
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-text": "4.0.2",
    "rehype-parse": "9.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
